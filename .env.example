# Copy this file to .env and fill in your values.
# .env is excluded from git — never commit real credentials.

# ── SQL Server connection ──────────────────────────────────────────────────────
DB_HOST=your-sql-server-host
DB_PORT=1433
DB_NAME=your-database-name
DB_USER=your-username
DB_PASS=your-password
DB_DRIVER=ODBC+Driver+17+for+SQL+Server

# SSL: set "yes" ONLY for local dev with a self-signed cert.
# Must be "no" in production so the real cert chain is verified.
DB_TRUST_SERVER_CERT=no

# ── Authentication ─────────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=change-me-to-a-random-secret

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory for rotating log files (default: /tmp/camfart_logs)
LOG_DIR=/var/log/camfart
